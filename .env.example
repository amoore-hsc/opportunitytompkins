# ──────────────────────────────────────────────
# Frontend (Vite)
# ──────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ──────────────────────────────────────────────
# Email (Resend)
# ──────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ──────────────────────────────────────────────
# Job Scraping (Firecrawl)
# ──────────────────────────────────────────────
FIRECRAWL_API_KEY="fc-xxxxxxxxxxxxxxxx"

# ──────────────────────────────────────────────
# AI Gateway (Lovable AI — for job categorization & wage enrichment)
# ──────────────────────────────────────────────
LOVABLE_API_KEY="lov-xxxxxxxxxxxxxxxx"

# ──────────────────────────────────────────────
# Edge Function Security
# ──────────────────────────────────────────────
# Shared secret used to authorize internal cron/edge-function calls.
# Generate a strong random value (e.g. `openssl rand -hex 32`).
INTERNAL_TASK_SECRET="your-random-secret"

# ──────────────────────────────────────────────
# Email / Site Configuration (Edge Functions)
# ──────────────────────────────────────────────
FROM_EMAIL="hello@your-site.org"
FROM_NAME="Opportunity Board"
SUPPORT_EMAIL="support@your-site.org"
ALERT_RECIPIENTS="admin1@your-site.org,admin2@your-site.org"
SITE_NAME="Opportunity Board"
SITE_URL="https://your-site.org"

# ──────────────────────────────────────────────
# Job-Location Filtering (Edge Functions)
# ──────────────────────────────────────────────
# Comma-separated, lowercase. Used by the scraper to exclude out-of-area jobs.
COUNTY_PLACES="yourcity,yourtown,yourvillage"
OUT_OF_COUNTY_BLOCKLIST="neighboringcity1,neighboringcity2"
OUT_OF_STATE_REGIONS=" ak, al, ar, az, ca, co, ct, dc, de, fl, ga, hi, ia, id, il, in, ks, ky, la, ma, md, me, mi, mn, mo, ms, mt, nc, nd, ne, nh, nj, nm, nv, oh, ok, or, pa, ri, sc, sd, tn, tx, ut, va, vt, wa, wi, wv, wy"

# ──────────────────────────────────────────────
# Google Chat Notifications (optional)
# ──────────────────────────────────────────────
# If set, feedback submissions and weekly webhook tests post to Google Chat.
GOOGLE_CHAT_WEBHOOK_URL=""
